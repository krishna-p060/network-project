#!/usr/bin/env python3
"""bserve: serve a directory over BHTTP/1 (see SPEC.md).

Usage: ./bserve ./www 9000
"""

import argparse
import email.utils
import json
import mimetypes
import os
import signal
import socket
import socketserver
import sys
import threading
import time
import uuid
from urllib.parse import unquote

import bmetrics
import bproto
from bproto import DATA, DATA_CHUNK, END_STREAM, GOAWAY, HEADERS, Frame

SERVER_NAME = "bserve/1.0"
UNKNOWN_TYPE = 0x7F
REASONS = {
    200: "OK",
    400: "Bad Request",
    404: "Not Found",
    405: "Method Not Allowed",
    500: "Internal Server Error",
}
MIME_TYPES = mimetypes.MimeTypes()


class BadRequest(Exception):
    pass


def parse_request(frame):
    """Return (method, path, request_id) from a request HEADERS frame, or raise BadRequest."""
    if frame.stream_id == 0:
        raise BadRequest("HEADERS on stream 0")
    try:
        headers = bproto.decode_headers(frame.payload)
    except bproto.MalformedHeaders as e:
        raise BadRequest(str(e)) from None
    pseudo = {}
    request_id = None
    for name, value in headers:
        if name == "x-request-id":
            request_id = value
        if not name.startswith(":"):
            continue
        if name not in (":method", ":path"):
            raise BadRequest(f"{name} is not allowed in a request")
        if name in pseudo:
            raise BadRequest(f"{name} appears twice")
        pseudo[name] = value
    if len(pseudo) != 2:
        raise BadRequest("a request needs both :method and :path")
    if not pseudo[":path"].startswith("/"):
        raise BadRequest(":path must start with /")
    return pseudo[":method"], pseudo[":path"], request_id


def resolve(root, path):
    """Map a request path to a regular file inside root, or return None."""
    path = unquote(path.split("?", 1)[0])
    if "\0" in path:
        return None
    full = os.path.realpath(os.path.join(root, path.lstrip("/")))
    if os.path.isdir(full):
        full = os.path.realpath(os.path.join(full, "index.html"))
    if os.path.commonpath([root, full]) != root or not os.path.isfile(full):
        return None
    return full


class Connection(socketserver.BaseRequestHandler):
    """One client connection: answer requests until the client closes it."""

    def handle(self):
        self.server.metrics.connection_opened()
        try:
            while True:
                try:
                    frame = bproto.read_frame(self.request)
                except bproto.FrameTooLarge as e:
                    self.server.metrics.protocol_error()
                    self.started = time.monotonic()
                    self.request_id = None
                    self.fail(e.stream_id, "-", "-", 400, str(e))
                    self.send(Frame(GOAWAY, 0, 0, b"frame too large"))
                    return
                if frame is None or frame.type == GOAWAY:
                    return
                if frame.type == HEADERS:
                    self.answer(frame)
                # DATA from a client and frames of unknown type are read and dropped.
        except (bproto.Truncated, OSError):
            return
        finally:
            self.server.metrics.connection_closed()

    def answer(self, frame):
        self.started = time.monotonic()
        self.request_id = None
        stream_id = frame.stream_id
        try:
            method, path, self.request_id = parse_request(frame)
        except BadRequest as e:
            return self.fail(stream_id, "-", "-", 400, str(e))
        if method != "GET":
            return self.fail(stream_id, method, path, 405)
        try:
            full = resolve(self.server.root, path)
            body = open(full, "rb") if full else None
        except OSError:
            body = None
        except Exception as e:
            return self.fail(stream_id, method, path, 500, repr(e))
        if body is None:
            return self.fail(stream_id, method, path, 404)
        with body:
            size = os.fstat(body.fileno()).st_size
            content_type = MIME_TYPES.guess_type(full)[0] or "application/octet-stream"
            self.send_head(stream_id, 200, content_type, size)
            remaining = size
            while remaining:
                chunk = body.read(min(DATA_CHUNK, remaining))
                if not chunk:
                    raise OSError(f"{full} shrank while it was being sent")
                remaining -= len(chunk)
                self.send(Frame(DATA, 0 if remaining else END_STREAM, stream_id, chunk))
        self.finish_request(stream_id, method, path, 200, size, f"{size} bytes")

    def send(self, frame):
        self.request.sendall(bproto.encode_frame(frame))

    def send_head(self, stream_id, status, content_type, length):
        if self.server.inject_unknown:
            self.send(Frame(UNKNOWN_TYPE, 0, stream_id, b"future"))
        headers = [
            (":status", str(status)),
            ("content-type", content_type),
            ("content-length", str(length)),
            ("server", SERVER_NAME),
            ("date", email.utils.formatdate(usegmt=True)),
        ]
        headers += self.server.extra_headers
        if self.request_id:
            headers.append(("x-request-id", self.request_id))
        flags = END_STREAM if length == 0 else 0
        self.send(Frame(HEADERS, flags, stream_id, bproto.encode_headers(headers)))

    def fail(self, stream_id, method, path, status, detail=""):
        text = f"{status} {REASONS[status]}\n" + (f"{detail}\n" if detail else "")
        body = text.encode()
        self.send_head(stream_id, status, "text/plain; charset=utf-8", len(body))
        self.send(Frame(DATA, END_STREAM, stream_id, body))
        self.finish_request(stream_id, method, path, status, len(body), detail)

    def finish_request(self, stream_id, method, path, status, body_bytes, detail):
        seconds = time.monotonic() - self.started
        self.server.metrics.observe(method, status, seconds, body_bytes)
        host, port = self.client_address[:2]
        if self.server.log_format == "json":
            record = {
                "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "level": "error" if status >= 500 else "warn" if status >= 400 else "info",
                "msg": "request",
                "client": f"{host}:{port}",
                "stream": stream_id,
                "method": method,
                "path": path,
                "status": status,
                "bytes": body_bytes,
                "duration_ms": round(seconds * 1000, 3),
                "request_id": self.request_id or str(uuid.uuid4()),
                "version": self.server.version,
            }
            if detail:
                record["detail"] = detail
            line = json.dumps(record)
        else:
            request = "-" if method == "-" else f"{method} {path}"
            line = f"{host}:{port} stream={stream_id} {request} {status}"
            if detail:
                line += f" ({detail})"
        print(line, file=sys.stderr, flush=True)


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, address, root, inject_unknown, metrics, log_format, version, extra_headers):
        self.root = root
        self.inject_unknown = inject_unknown
        self.metrics = metrics
        self.log_format = log_format
        self.version = version
        self.extra_headers = extra_headers
        super().__init__(address, Connection)


def env_int(name, default):
    value = os.environ.get(name)
    return int(value) if value else default


def main():
    parser = argparse.ArgumentParser(prog="bserve", description="Serve a directory over BHTTP/1 (see SPEC.md).")
    parser.add_argument("root", help="directory to serve")
    parser.add_argument("port", type=int, help="TCP port to listen on; 0 picks a free one")
    parser.add_argument("--bind", default="", metavar="ADDR", help="address to listen on (default: all interfaces)")
    parser.add_argument(
        "--inject-unknown",
        action="store_true",
        help="send a frame of unknown type 0x7f before every response, to check that clients skip it",
    )
    parser.add_argument(
        "--metrics-port",
        type=int,
        default=env_int("BSERVE_METRICS_PORT", None),
        metavar="PORT",
        help="serve /metrics, /healthz and /readyz over HTTP on this port (env BSERVE_METRICS_PORT; default: off)",
    )
    parser.add_argument(
        "--log-format",
        choices=("text", "json"),
        default=os.environ.get("BSERVE_LOG_FORMAT", "text"),
        help="request log format (env BSERVE_LOG_FORMAT; default: text)",
    )
    parser.add_argument(
        "--drain-seconds",
        type=float,
        default=float(os.environ.get("BSERVE_DRAIN_SECONDS", "0")),
        metavar="S",
        help="on SIGTERM, report not-ready for S seconds before closing (env BSERVE_DRAIN_SECONDS; default: 0)",
    )
    args = parser.parse_args()
    root = os.path.realpath(args.root)
    if not os.path.isdir(root):
        parser.error(f"{args.root} is not a directory")
    if not 0 <= args.port <= 0xFFFF:
        parser.error(f"port {args.port} is out of range")

    version = os.environ.get("BSERVE_VERSION", "dev")
    extra_headers = []
    if "BSERVE_VERSION" in os.environ:
        extra_headers = [("x-version", version), ("x-served-by", socket.gethostname())]
    metrics = bmetrics.Metrics(version)

    try:
        server = Server((args.bind, args.port), root, args.inject_unknown, metrics, args.log_format, version, extra_headers)
    except OSError as e:
        sys.exit(f"bserve: cannot listen on port {args.port}: {e}")
    host, port = server.server_address[:2]
    print(f"bserve: serving {root} on {host}:{port}", file=sys.stderr, flush=True)

    admin = None
    if args.metrics_port is not None:
        try:
            admin = bmetrics.AdminServer((args.bind, args.metrics_port), metrics)
        except OSError as e:
            sys.exit(f"bserve: cannot listen on metrics port {args.metrics_port}: {e}")
        threading.Thread(target=admin.serve_forever, daemon=True).start()
        print(f"bserve: metrics on {admin.server_address[0]}:{admin.server_address[1]} (version {version})", file=sys.stderr, flush=True)

    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    threading.Thread(target=server.serve_forever, daemon=True).start()
    if admin:
        admin.ready.set()
    try:
        stop.wait()
    except KeyboardInterrupt:
        pass
    # Kubernetes keeps sending new connections for a moment after SIGTERM, until the
    # endpoint is removed; staying up and not-ready for a few seconds avoids refusing them.
    if admin:
        admin.ready.clear()
    if args.drain_seconds > 0:
        print(f"bserve: draining for {args.drain_seconds:g}s", file=sys.stderr, flush=True)
        time.sleep(args.drain_seconds)
    server.shutdown()
    server.server_close()
    if admin:
        admin.shutdown()
    print("bserve: stopped", file=sys.stderr, flush=True)


if __name__ == "__main__":
    main()
